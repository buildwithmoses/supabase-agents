  "review": {
    "explanations": [
      {
        "item": "bookings.club_id",
        "explanation": "Every value points to an existing club, so a foreign key to clubs was added safely. Bookings cannot reference a club that does not exist."
      },
      {
        "item": "bookings.member_uid",
        "explanation": "The Firebase user id became a uuid column named member_id, built with uuid5 from the Firebase uid. This lets row-level security compare it to auth.uid(), but it only matches real logins if those auth users were created with the same uuid5 mapping."
      },
      {
        "item": "bookings.starts_at",
        "explanation": "Some values were Firestore timestamps and others were ISO strings, and the strings were parsed into one timestamp type. Check that any string without a timezone was read in the timezone you expect."
      },
      {
        "item": "clubs.owner_uid",
        "explanation": "The Firebase owner id became a uuid column named owner_id, using the same uuid5 mapping as the other user ids. Ownership checks in row-level security will work only once auth accounts use that mapping."
      },
      {
        "item": "clubs.settings",
        "explanation": "Settings keys vary from document to document, so the column is jsonb to hold whatever shape each club has. Nothing is enforced per key, so validate values in the application."
      },
      {
        "item": "courts.hourly_rate",
        "explanation": "Most rates were numbers, and one numeric string was converted. Confirm the converted value is in the same currency unit as the rest."
      },
      {
        "item": "members.dupr_rating",
        "explanation": "Two numeric strings were converted, but one non-numeric value was set to NULL, which loses that original value. Keep a copy of the source document if that rating must be recoverable."
      },
      {
        "item": "members.uid",
        "explanation": "The Firebase user id became a uuid column named user_id, built with uuid5 for row-level security. As with the other user ids, it matches auth.uid() only if auth accounts use the same mapping."
      },
      {
        "item": "leagues.club_id",
        "explanation": "Every value matches a club, so the foreign key was added without issues. Leagues always belong to an existing club."
      },
      {
        "item": "payments.club_id",
        "explanation": "Every value matches a club, so the foreign key is safe. Payments are tied to valid clubs."
      },
      {
        "item": "payments.member_uid",
        "explanation": "The Firebase user id became a uuid column named member_id using uuid5, so row-level security can check it against auth.uid(). The same mapping must be used when creating auth accounts for this to work."
      },
      {
        "item": "payments.metadata",
        "explanation": "Metadata keys differ across payments, so it is stored as jsonb. Expect no database-level checks on its contents."
      },
      {
        "item": "payments.method",
        "explanation": "The method map had the keys last4 and type in at least 90 percent of documents, so they became separate columns. Payments missing those keys will have NULLs in those columns, which is expected but worth checking."
      },
      {
        "item": "bookings.players",
        "explanation": "This array of references was moved to a join table, bookings_players, which is the standard way to store many-to-many links in Postgres. Foreign keys there keep player links consistent."
      },
      {
        "item": "members.favorite_courts",
        "explanation": "This array of references was moved to a join table, members_favorite_courts, so each favorite is a proper row that can be queried and constrained. The link can be enforced with foreign keys to members and courts."
      }
    ],
