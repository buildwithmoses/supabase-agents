  "review": {
    "explanations": [
      {
        "item": "bookings.club_id",
        "explanation": "Every value already points to a club, so a foreign key to clubs was added safely. Bookings can no longer reference a club that does not exist."
      },
      {
        "item": "bookings.member_uid",
        "explanation": "The Firebase user id is converted into a uuid column named member_id using a deterministic uuid5 hash, so row-level security can compare it to auth.uid(). Confirm that Supabase Auth issues ids generated with the same hash, or the policies will never match."
      },
      {
        "item": "bookings.starts_at",
        "explanation": "The column mixed real Firestore timestamps with ISO text strings, and the strings were parsed into timestamps. Check any string formats that failed to parse, since they may have been handled differently than expected."
      },
      {
        "item": "clubs.owner_uid",
        "explanation": "The Firebase owner id becomes a deterministic uuid in owner_id so RLS can check ownership against auth.uid(). The same auth id mapping must be used here as everywhere else."
      },
      {
        "item": "clubs.settings",
        "explanation": "Settings are free-form and their keys vary between documents, so they are stored as jsonb to avoid losing fields. Queries on specific keys will need to be written against the jsonb structure."
      },
      {
        "item": "courts.hourly_rate",
        "explanation": "Most values were numbers, and one numeric string was converted to a number. The type remains numeric, so this change is low risk, but it is worth a quick check on that single row."
      },
      {
        "item": "members.dupr_rating",
        "explanation": "Two numeric strings were converted to numbers, but one non-numeric value was set to NULL. That value is lost from the database, so keep the source document if the original text matters."
      },
      {
        "item": "members.uid",
        "explanation": "The Firebase user id becomes a deterministic uuid in user_id for RLS comparison with auth.uid(). This depends on the same auth id mapping being used consistently across all tables."
      },
      {
        "item": "leagues.club_id",
        "explanation": "Every value matches a row in clubs, so the foreign key was added without any data cleanup. Leagues stay tied to valid clubs."
      },
      {
        "item": "payments.club_id",
        "explanation": "Every value matches a row in clubs, so the foreign key was added safely. Payments cannot point to a missing club."
      },
      {
        "item": "payments.member_uid",
        "explanation": "The Firebase user id becomes a deterministic uuid in member_id for RLS comparison with auth.uid(). Payments can be scoped to the same member identity used elsewhere."
      },
      {
        "item": "payments.metadata",
        "explanation": "Metadata keys differ between documents, so it is stored as jsonb to preserve every field. Like other jsonb columns, it will need careful querying and may need promotion to real columns later."
      },
      {
        "item": "payments.method",
        "explanation": "The method map was flattened into columns for last4 and type because at least 90% of documents share those keys. Documents missing either key will have NULL in those columns, so check that NULL is an acceptable meaning for them."
      },
      {
        "item": "bookings.players",
        "explanation": "This was an array of references, so it moved into a join table bookings_players. Each player link is now a proper row that can be constrained and indexed."
      },
      {
        "item": "members.favorite_courts",
        "explanation": "This was an array of court references, so it moved into a join table members_favorite_courts. Each favorite is now a separate row that can reference a court directly."
      }
    ],
