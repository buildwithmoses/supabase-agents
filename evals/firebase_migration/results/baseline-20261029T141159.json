  "review": {
    "explanations": [
      {
        "item": "bookings.club_id",
        "explanation": "Every value already matches a club, so a foreign key to clubs is safe to add and will keep bookings tied to real clubs."
      },
      {
        "item": "bookings.member_uid",
        "explanation": "The Firebase user id is converted to a deterministic uuid stored as member_id, so row-level security can compare it directly to auth.uid(). Keep the mapping consistent across tables so the same user always gets the same uuid."
      },
      {
        "item": "bookings.starts_at",
        "explanation": "Some values were Firestore timestamps and others were ISO strings; parsing the strings gives one consistent timestamp type. Check that strings without a timezone were interpreted in the intended zone."
      },
      {
        "item": "clubs.owner_uid",
        "explanation": "Same approach as member ids: the Firebase uid becomes a uuid owner_id so ownership checks work with auth.uid() in RLS."
      },
      {
        "item": "clubs.settings",
        "explanation": "Its keys vary from document to document, so storing it as jsonb avoids guessing a fixed column set. Queries on specific keys will be less strict than columns, so validate important keys in the application."
      },
      {
        "item": "courts.hourly_rate",
        "explanation": "Numeric strings were converted to numbers, but non-numeric strings became NULL, so any rates that were previously text-only will now be missing. Review those NULL rows before relying on rate totals."
      },
      {
        "item": "members.dupr_rating",
        "explanation": "Mixed numbers and numeric strings were unified into a number; non-numeric strings became NULL. Check whether those NULLs represent real missing ratings or bad source data."
      },
      {
        "item": "members.uid",
        "explanation": "The Firebase uid becomes a deterministic uuid user_id so members can be matched to auth.uid() under RLS."
      },
      {
        "item": "leagues.club_id",
        "explanation": "All values reference existing clubs, so the foreign key is safe and enforces that each league belongs to a club."
      },
      {
        "item": "payments.club_id",
        "explanation": "All values reference existing clubs, so the foreign key is safe and prevents orphaned payments."
      },
      {
        "item": "payments.member_uid",
        "explanation": "Mapped to a deterministic uuid member_id for RLS comparisons with auth.uid(), consistent with the other member references."
      },
      {
        "item": "payments.metadata",
        "explanation": "Free-form keys differ by document, so jsonb preserves everything without forcing a schema. Avoid relying on it for core payment fields."
      },
      {
        "item": "payments.method",
        "explanation": "The last4 and type keys appear in at least 90 percent of documents, so flattening them into columns is practical. The few documents missing these keys will have NULLs in those columns, which is expected."
      },
      {
        "item": "bookings.players",
        "explanation": "An array of references becomes a join table so players can be queried and constrained with foreign keys instead of living in an array column."
      },
      {
        "item": "members.favorite_courts",
        "explanation": "Stored as a join table so favorite courts are real references to courts with foreign key integrity, rather than an unchecked array of ids."
      }
    ],
    "renames_accepted": [],
    "renames_rejected": [
      {
        "old": "clubs/courts",
        "new": "courts",
        "why": "Already named courts; no change needed, but a clearer name would be club_courts to show the parent club relationship."
      },
      {
        "old": "clubs/members",
        "new": "club_members",
        "why": "The name members is ambiguous next to the top-level user concept; club_members makes clear these rows are a club's membership records."
      }
    ],
