  "review": {
    "explanations": [
      {
        "item": "bookings.club_id",
        "explanation": "Every value already matches an existing club, so a foreign key to clubs was added without dropping any rows. Bookings tied to a club cannot now point at a missing club."
      },
      {
        "item": "bookings.member_uid",
        "explanation": "The Firebase user id is converted to a uuid (member_id) using uuid5, so row-level security can compare it with auth.uid(). The conversion is one-way, so the auth system must derive the same uuid from the Firebase uid or the policies will silently block access."
      },
      {
        "item": "bookings.starts_at",
        "explanation": "The column mixed Firestore timestamps with ISO strings. The strings were parsed into the timestamp type so all values sort and compare correctly. Check any strings in an unusual format, since they could have been parsed with the wrong timezone."
      },
      {
        "item": "clubs.owner_uid",
        "explanation": "Same uuid5 conversion as the other user ids, stored as owner_id so ownership-based policies can match auth.uid(). The same caveat applies: the auth side must produce identical uuids."
      },
      {
        "item": "clubs.settings",
        "explanation": "Kept as jsonb because the keys vary from document to document. Nothing in the database enforces its shape, so the application must validate keys it depends on."
      },
      {
        "item": "courts.hourly_rate",
        "explanation": "Numeric strings were converted to numbers, and one value was affected. Confirm that conversion is correct for that one row, since a wrong value would silently change pricing."
      },
      {
        "item": "members.dupr_rating",
        "explanation": "Two numeric strings were converted to numbers. One non-numeric value was set to NULL, which is data loss, so review that member's original value if the rating matters."
      },
      {
        "item": "members.uid",
        "explanation": "Firebase user id converted to a uuid user_id using uuid5 so row-level security can match auth.uid(). The conversion is one-way, so the mapping from Firebase uid to uuid must be kept consistent wherever users are created or migrated."
      },
      {
        "item": "leagues.club_id",
        "explanation": "Every value matches an existing club, so a foreign key was added with no rows removed. Leagues always belong to a valid club."
      },
      {
        "item": "payments.club_id",
        "explanation": "Every value matches an existing club, so a foreign key was added with no rows removed. Payments always link to a valid club."
      },
      {
        "item": "payments.member_uid",
        "explanation": "Converted to a uuid member_id with uuid5 so policies can compare it with auth.uid(). Confirm that the same derivation is used across all tables so one member's uuid matches everywhere."
      },
      {
        "item": "payments.metadata",
        "explanation": "Kept as jsonb because the keys differ between documents. Financial fields that matter for reporting should be promoted to real columns later rather than queried from this blob."
      },
      {
        "item": "payments.method",
        "explanation": "Most documents had the same keys, last4 and type, so they were flattened into columns. Documents missing those keys will have NULLs, so check that NULL is an acceptable meaning for them."
      },
      {
        "item": "bookings.players",
        "explanation": "This is an array of references, so it became a join table, bookings_players, which allows proper foreign keys and queries in both directions. Make sure every referenced player exists before the foreign keys are enforced."
      },
      {
        "item": "members.favorite_courts",
        "explanation": "This is an array of references, so it became the join table members_favorite_courts. That keeps each member-court pair as its own row with working foreign keys."
      }
    ],
